# Garuda — env vars
# Copy to .env and fill values. .env should be gitignored.

# ─── Static stage (HF source) ─────────────────────────────────────────
# Required for gated models (Llama, Gemma, some Qwen variants).
# Skip if using --local-path mode exclusively.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Dynamic stage (behavioural eval) ─────────────────────────────────

# Target model API key — only when using `scan dynamic --endpoint <URL>`
TARGET_MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# LiteLLM proxy — judge model (gemini-2.5-flash) lives here. MANDATORY.
LITELLM_BASE_URL=http://litellm.internal:4000
# Optional — only if proxy enforces auth.
LITELLM_API_KEY=sk-litellm-xxxxxxxxxxxx

# Optional — only if LiteLLM proxy propagates upstream key explicitly.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Static stage tooling ─────────────────────────────────────────────
# Set false when running offline (no internet for CVE DB refresh).
GRYPE_DB_AUTO_UPDATE=true

# ─── Debug / dev ──────────────────────────────────────────────────────
# 1 = DEBUG logging across all stages.
SCAN_DEBUG=0

# 1 = enable integration test for local-serve subcommand
# (requires GPU + transformers loadable model). Default skipped.
SCAN_TEST_LOCAL_SERVE=0
